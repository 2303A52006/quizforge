# Copy these names into your hosting dashboard's "Environment variables" page.
# (For local development you do NOT need any of them.)
DJANGO_SECRET_KEY=put-a-long-random-string-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
DJANGO_TIME_ZONE=Asia/Kolkata
# Optional: where the SQLite file lives (must be on a persistent disk)
# DATABASE_PATH=/home/yourname/quizforge/db.sqlite3
